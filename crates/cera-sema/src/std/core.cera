# Stub signatures for the always-available core names (the prelude).
# Bodies live in the real standard library; the compiler only needs types.

Option<T> :: type
  | Some(T)
  | None
end

Result<T, E> :: type
  | Ok(T)
  | Err(E)
end

Ordering :: type
  | Less
  | Equal
  | Greater
end

Allocator :: type

# Errors from the outside world carry a message.
Error :: type { message: String }

# Persistent ordered collections (see std.map and std.set).
Map<K, V> :: type
Set<T> :: type
# A growable array changed in place (see std.array).
Array<T> :: type

# Capabilities handed to `main :: fn(caps: Caps)`.
Console :: type
Dir :: type
Clock :: type
EnvCap :: type
Caps :: type { console: Console, fs: Dir, clock: Clock, env: EnvCap }

promote :: fn<T>(value: T) -> T
ref_of :: fn<T>(value: T) -> ref T
new_in :: fn<T>(alloc: Allocator, value: T) -> ref T
arena_new :: fn(size: usize) -> Allocator

# Core traits. The language itself relies on these: `Show` for printing,
# `Ord` for `< <= > >=`, and `Add` ... `Neg` for the arithmetic operators.
# Implementations for the built-in types are generated by the compiler.

Show :: trait
  show :: fn(self) -> String
end

Ord :: trait
  compare :: fn(self, other: Self) -> Ordering
end

Add :: trait
  add :: fn(self, other: Self) -> Self
end

Sub :: trait
  sub :: fn(self, other: Self) -> Self
end

Mul :: trait
  mul :: fn(self, other: Self) -> Self
end

Div :: trait
  div :: fn(self, other: Self) -> Self
end

Rem :: trait
  rem :: fn(self, other: Self) -> Self
end

# `Bitwise` for `& ^ << >> ~`: the integer types.
Bitwise :: trait
  bitwise :: fn(self, other: Self) -> Self
end

Neg :: trait
  neg :: fn(self) -> Self
end

# errors1: Generic types in signatures
# Book: chapter 11
# I AM NOT DONE

ParseError :: type
  | Empty
  | NotANumber(text: String)
end

parse_age :: fn(text: String) -> Result<i32, ParseError do
  if text == "" do
    Err(Empty)
  else
    Ok(0)
  end
end

# HINT
# Type arguments open with `<` and close with `>`.
